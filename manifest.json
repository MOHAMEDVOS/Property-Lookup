{
  "manifest_version": 3,
  "name": "Property Lookup",
  "version": "0.1.8",
  "description": "Paste an address, get price, beds, baths and links from Zillow and Redfin.",
  "action": {
    "default_title": "Property Lookup",
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.zillow.com/*",
    "https://www.redfin.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.readymode.com/*"
      ],
      "js": [
        "readymode.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  }
}